# Keystatic GitHubモードに必要な環境変数の雛形。
# 実際の値は .env に入れる（.env はコミットしない）。本番は Vercel の
# Settings > Environment Variables に同じ5つを登録する。
#
# 値は /keystatic/setup で GitHub App を作成すると .env に自動で書き込まれる。
# PUBLIC_ 付きの2つはブラウザ側に埋め込まれる公開値、残り3つは秘密情報。

PUBLIC_KEYSTATIC_REPO=owner/repo-name
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=your-github-app-slug
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
