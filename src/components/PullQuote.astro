---
const { text, cite } = Astro.props;
---
<figure class="pq">
  <blockquote>{text}</blockquote>
  {cite && <figcaption>— {cite}</figcaption>}
</figure>
<style>
.pq{margin:clamp(50px,7vh,80px) 0;border-left:1px solid currentColor;padding-left:clamp(24px,4vw,40px)}
.pq blockquote{font-size:clamp(17px,2vw,21px);letter-spacing:.14em;line-height:2.4;font-weight:500;white-space:pre-wrap}
.pq figcaption{margin-top:18px;font-family:'Bodoni Moda',serif;font-style:italic;font-size:12px;letter-spacing:.2em;color:#8a8a85}
</style>
