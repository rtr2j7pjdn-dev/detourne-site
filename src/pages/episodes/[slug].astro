---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { toYouTubeId } from '../../lib/youtube';
import { toExcerpt } from '../../lib/excerpt';

export async function getStaticPaths() {
  // 下書きのエピソードはページ自体を作らない（＝非公開）
  const episodes = (await getCollection('episodes')).filter((e) => e.data.status === 'published');
  return episodes.map((e) => ({ params: { slug: e.id }, props: { e } }));
}
const { e } = Astro.props;
const epLabel = String(e.data.epNumber).padStart(2, '0');
// 本文未入力のエピソードでは本文セクションごと出さない
const hasBody = Boolean(e.body && e.body.trim());
const videoId = toYouTubeId(e.data.youtubeId);
const Body = hasBody ? (await render(e)).Content : null;

// 検索結果・SNS向けの情報。ダンサー名を必ず含める
const dancerName = e.data.dancerJa.replace(/\s+/g, '');
const seoTitle = `${e.data.dancerJa}の素顔 — DÉTOURNÉ EP.${epLabel}`;
const seoDescription = hasBody
  ? `${dancerName}インタビュー。${toExcerpt(e.body, 90)}`
  : `${dancerName}（${e.data.dancerEn}）を追うDÉTOURNÉ EP.${epLabel}。舞台の顔、その裏側にある素顔を記録するポートレート・シリーズ。`;
const seoImage = e.data.thumbnail ?? '/og.png';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: seoTitle,
  description: seoDescription,
  image: new URL(seoImage, Astro.site).href,
  inLanguage: 'ja',
  datePublished: e.data.publishDate ?? undefined,
  about: { '@type': 'Person', name: dancerName, alternateName: e.data.dancerEn, jobTitle: 'Ballet Dancer' },
  author: { '@type': 'Person', name: '堀 貴文' },
  publisher: { '@type': 'Organization', name: 'DÉTOURNÉ' },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---
<Base title={seoTitle} description={seoDescription} image={seoImage} type="article" jsonLd={jsonLd}>
<section class="light" style="min-height:100vh;padding-top:140px">
  <div class="kicker wr in">
    <span class="num">{epLabel}</span><span class="rule"></span>
    <span class="label">{e.data.dancerJa}<span class="label-en">{e.data.dancerEn}</span></span>
  </div>
  <div class="ep-grid">
    <div class="screen">
      {videoId ? (
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${videoId}`}
          title={`DÉTOURNÉ EP.${epLabel}`}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      ) : e.data.thumbnail ? (
        <img class="ep-thumb" src={e.data.thumbnail} alt={`EP.${epLabel} ${e.data.dancerJa}`} />
      ) : (
        <div class="placeholder">
          <span class="ep-num">EP. {epLabel}</span>
          <span class="ep-note">COMING SOON</span>
        </div>
      )}
    </div>
    <div class="ep-meta">
      <ol class="chapters">
        {e.data.chapters.map((c) => (
          <li><span class="n">{c.numeral}</span>{c.title}</li>
        ))}
      </ol>
    </div>
  </div>
  {Body && (
    <div class="episode-body">
      <Body />
    </div>
  )}
</section>
</Base>
