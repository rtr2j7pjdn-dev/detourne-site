---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { toYouTubeId } from '../../lib/youtube';

export async function getStaticPaths() {
  const episodes = await getCollection('episodes');
  return episodes.map((e) => ({ params: { slug: e.data.slug }, props: { e } }));
}
const { e } = Astro.props;
const epLabel = String(e.data.epNumber).padStart(2, '0');
// 本文未入力のエピソードでは本文セクションごと出さない
const hasBody = Boolean(e.body && e.body.trim());
const videoId = toYouTubeId(e.data.youtubeId);
const Body = hasBody ? (await render(e)).Content : null;
---
<Base title={`EP.${epLabel} ${e.data.dancerJa} — DÉTOURNÉ`}>
<section class="light" style="min-height:100vh;padding-top:140px">
  <div class="kicker wr in">
    <span class="num">{epLabel}</span><span class="rule"></span>
    <span class="label">{e.data.dancerJa}<span class="label-en">{e.data.dancerEn}</span></span>
  </div>
  <div class="ep-grid">
    <div class="screen">
      {videoId ? (
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${videoId}`}
          title={`DÉTOURNÉ EP.${epLabel}`}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      ) : e.data.thumbnail ? (
        <img class="ep-thumb" src={e.data.thumbnail} alt={`EP.${epLabel} ${e.data.dancerJa}`} />
      ) : (
        <div class="placeholder">
          <span class="ep-num">EP. {epLabel}</span>
          <span class="ep-note">COMING SOON</span>
        </div>
      )}
    </div>
    <div class="ep-meta">
      <ol class="chapters">
        {e.data.chapters.map((c) => (
          <li><span class="n">{c.numeral}</span>{c.title}</li>
        ))}
      </ol>
    </div>
  </div>
  {Body && (
    <div class="episode-body">
      <Body />
    </div>
  )}
</section>
</Base>
