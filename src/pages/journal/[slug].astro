---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('journal')).filter((j) => j.data.status === 'published');
  return posts.map((j) => ({ params: { slug: j.data.slug }, props: { j } }));
}
const { j } = Astro.props;
const { Content } = await render(j);
---
<Base title={`${j.data.title} — DÉTOURNÉ Journal`}>
<article class="light" style="min-height:100vh;padding:140px clamp(24px,7vw,120px) 120px">
  <p style="font-family:var(--serif-en);font-style:italic;font-size:12px;letter-spacing:.24em;color:var(--muted)">{j.data.category} — {j.data.date ?? ''}</p>
  <h1 style="font-size:clamp(24px,3vw,36px);letter-spacing:.18em;font-weight:500;margin:18px 0 16px;line-height:1.9">{j.data.title}</h1>
  <p style="font-size:11px;letter-spacing:.14em;color:var(--muted);border-top:1px solid currentColor;padding-top:14px;margin-bottom:50px">本記事にはアフィリエイトリンクが含まれる場合があります。</p>
  {j.data.coverImage && (
    <img class="journal-cover" src={j.data.coverImage} alt={j.data.title} />
  )}
  <div class="journal-body">
    <Content />
  </div>
</article>
</Base>
